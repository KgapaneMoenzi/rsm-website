# Copy these into Render > your service > Environment (never commit a real .env file)
NODE_ENV=production
# Neon: Dashboard > your project > Connect > copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# The password you will type on /admin (at least 10 characters)
ADMIN_PASSWORD=choose-a-long-password
# A random 64-character string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=paste-the-random-string-here
