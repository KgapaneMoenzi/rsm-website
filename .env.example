# Copy these into Render > your service > Environment (never commit a real .env file)
NODE_ENV=production
# Neon: Dashboard > your project > Connect > copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# The password you will type on /admin (at least 10 characters)
ADMIN_PASSWORD=choose-a-long-password
# A random 64-character string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=paste-the-random-string-here

# --- Email alerts (optional but recommended). See the Brevo steps in the chat ---
BREVO_API_KEY=paste-your-brevo-api-key
MAIL_FROM=the-email-you-verified-in-brevo@gmail.com
MAIL_FROM_NAME=RSM Student Accommodation
# Everyone who should get the "new booking" alert, separated by commas
LANDLORD_EMAILS=landlord@example.com,you@example.com
SITE_URL=https://rsm-student-accommodation.onrender.com
